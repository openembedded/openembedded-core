 				continue;
 			case ZBIN32:
 				Rxframeind = ZBIN32;
-				Crc32 = true;
 				c =  zrbhdr32(hdr);
 				if (c==ERROR) {
 					stats_msg_invalid();
@@ -814,7 +811,6 @@ zgethdr(unsigned char *hdr, int eflag, size_t *Rxpos)
 				continue;
 			case ZHEX:
 				Rxframeind = ZHEX;
-				Crc32 = false;
 				c =  zrhhdr(hdr);
 				if (c==ERROR) {
 					stats_msg_invalid();
