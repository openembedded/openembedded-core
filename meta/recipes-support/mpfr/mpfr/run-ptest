#!/bin/sh

cd "$(dirname "$0")/tests" || exit 1

for t in t*; do
    # Only the executable test programs, not data files or libraries.
    [ -f "$t" ] && [ -x "$t" ] || continue
    case "$t" in
        *.la|*.sh) continue ;;
    esac

    ./"$t"
    rc=$?

    case "$rc" in
        0)  echo "PASS: $t" ;;
        77) echo "SKIP: $t" ;;
        *)  echo "FAIL: $t" ;;
    esac
done
